# Render backend environment variables example
# Copy these into the Render dashboard as secret environment variables.
# Keep secrets out of git.

CBN_HOST=0.0.0.0
CBN_PORT=10000
CBN_LOG_LEVEL=INFO

# Email / Gmail SMTP
CBN_EMAIL_ENABLED=1
CBN_SMTP_HOST=smtp.gmail.com
CBN_SMTP_PORT=587
CBN_SMTP_USER=cbnetwork.sierraleone@gmail.com
CBN_SMTP_PASS=your_gmail_app_password_here
CBN_SMTP_FROM_NAME=CBN Sierra Leone
CBN_SMTP_REPLY_TO=cbnetwork.sierraleone@gmail.com
CBN_OFFICE_ADDRESS=15 Wilkinson Road, Freetown, Sierra Leone
CBN_OFFICE_PHONE=+232 76 000 000
CBN_OFFICE_EMAIL=cbnetwork.sierraleone@gmail.com

# Monime payment gateway
CBN_MONIME_ENABLED=1
CBN_MONIME_SPACE_ID=spc-your-space-id
CBN_MONIME_ACCESS_TOKEN=your_monime_access_token
CBN_MONIME_WEBHOOK_SECRET=your_webhook_secret
CBN_MONIME_FINANCIAL_ACCOUNT_ID=
CBN_MONIME_MODE=test
CBN_MONIME_PRIMARY_COLOR=#f36f21
CBN_PUBLIC_BASE_URL=https://your-render-app.onrender.com

# Misc
CBN_INBOX_POLL_SECONDS=120
